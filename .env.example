NODE_ENV=development
PORT=3000
# * allows all origins; or use comma-separated origins without trailing slashes.
# Empty/unset disables cross-origin browser access.
CORS_ORIGINS=*
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=simpasca
POSTGRES_USER=simpasca
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=
SEED_ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
